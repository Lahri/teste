# Azure DevOps
AZDO_ORG=
AZDO_PROJECT=
AZDO_PAT=
# Nome do campo customizado que guarda o nº da demanda do Trace no work item.
# Deixe em branco se esse vínculo ainda não existir.
AZDO_TRACE_LINK_FIELD=

# Trace — a API não está disponível (confirmado pelo NTI), os dados vêm por
# CSV exportado manualmente. Ver extract/extract_trace.py (mapeamento de
# colunas é placeholder até chegar o primeiro export real).
TRACE_CSV_PATH=data/manual/trace_export.csv

# Airtable (Painel de Análises dos analistas — fonte ao vivo de previsão de
# análise, status e observações). Gerar o token em airtable.com/create/tokens
# (NÃO é a mesma conexão OAuth usada pelo Claude) com escopo data.records:read
# e acesso à base "Painel de Análises - Comitê SESC".
AIRTABLE_PAT=
AIRTABLE_BASE_ID=app5DmsthrcOlJluK
AIRTABLE_ITENS_TABLE=Itens
AIRTABLE_OBSERVACOES_TABLE=Observacoes
