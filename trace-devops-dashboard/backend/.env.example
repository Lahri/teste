# Copie para .env e ajuste.

# "sqlite" (padrao): zero setup, roda local sem Docker/conta/instalar nada.
# "oracle": producao (ou um Oracle de teste real) -- preencha ORACLE_* abaixo.
DB_BACKEND=sqlite

# Só usado se DB_BACKEND=sqlite. Caminho do arquivo do banco (criado
# automaticamente na primeira vez que o backend rodar).
SQLITE_PATH=./data/painel.db

# Só usado se DB_BACKEND=oracle. Em dev local com docker-compose estes
# valores já batem com o container Oracle definido no docker-compose.yml
# -- só precisa trocar quando apontar pro Oracle real do SESC.
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=painel_demandas
ORACLE_PASSWORD=dev_local_only

CORS_ORIGINS=*
